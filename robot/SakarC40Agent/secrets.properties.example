# Copy this file to secrets.properties (same directory) and fill in real values.
# secrets.properties is git-ignored and must never be committed.
#
# These values come from Keenon for your registered application / robot fleet.
# Do NOT guess or reuse the AppId/Secret embedded in the Peanut SDK sample app.

APP_ID=
APP_SECRET=

# One of: DEFAULT, COM, COM_COAP, COAP, HTTP
# The correct value for the Keenon C40 has NOT been confirmed yet - see
# COMPATIBILITY_REPORT.md. Do not assume a value; determine it on the
# physical robot (e.g. by inspecting the existing Keenon app's configuration).
LINK_TYPE=DEFAULT

LINK_HOST=
LINK_PORT=0

# ---------------------------------------------------------------------
# Phase 3 (Robot Communication / MQTT). These come from the Sakar Cloud
# backend's robot registry, not from Keenon:
#   - SAKAR_ORGANIZATION_ID / SAKAR_SITE_ID / SAKAR_ROBOT_ID: the robot's
#     registered identity (POST /api/v1/robots response).
#   - SAKAR_AGENT_ID: any stable identifier for this agent installation.
#   - SAKAR_MQTT_USERNAME / SAKAR_MQTT_PASSWORD: from
#     POST /api/v1/robots/{id}/mqtt-credentials - the raw password is
#     returned exactly once at provisioning time and must be stored here,
#     not re-requested (re-posting rotates it and invalidates the old one).
# Leave all of these blank to run this diagnostic build with no Sakar
# Cloud link at all (SakarMqttConfigFactory treats an incomplete config as
# "not configured" and never connects).
SAKAR_MQTT_BROKER_URL=tcp://localhost:1883
SAKAR_ORGANIZATION_ID=
SAKAR_SITE_ID=
SAKAR_ROBOT_ID=
SAKAR_AGENT_ID=
SAKAR_MQTT_USERNAME=
SAKAR_MQTT_PASSWORD=
