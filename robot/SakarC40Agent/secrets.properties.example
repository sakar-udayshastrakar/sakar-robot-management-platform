# Copy this file to secrets.properties (same directory) and fill in real values.
# secrets.properties is git-ignored and must never be committed.
#
# These values come from Keenon for your registered application / robot fleet.
# Do NOT guess or reuse the AppId/Secret embedded in the Peanut SDK sample app.

APP_ID=
APP_SECRET=

# One of: DEFAULT, COM, COM_COAP, COAP, HTTP
# The correct value for the Keenon C40 has NOT been confirmed yet - see
# COMPATIBILITY_REPORT.md. Do not assume a value; determine it on the
# physical robot (e.g. by inspecting the existing Keenon app's configuration).
LINK_TYPE=DEFAULT

LINK_HOST=
LINK_PORT=0
