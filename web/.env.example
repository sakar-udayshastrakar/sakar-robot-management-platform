# Copy to .env.local for local development. Never commit a real .env/.env.local file.

# Base URL of the Sakar Cloud Backend REST API (no trailing slash).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Base URL of the Sakar Cloud Backend STOMP-over-WebSocket endpoint.
VITE_WS_URL=http://localhost:8080/ws

# Set to "true" to enable the WebSocket live-status client. Live SUBSCRIBE
# behavior was inconclusive in Phase 3 live validation (see
# docs/requirements/SAKAR_PHASE_3_LIVE_MQTT_VALIDATION_REPORT.md #24) — keep
# this off unless you are actively re-validating it, and never treat a
# missing update over this channel as evidence a robot is offline.
VITE_ENABLE_WEBSOCKET=false
